{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabrial Cockpit",
  "version": "0.5.1",
  "identifier": "com.bonjoski.fabrial.cockpit",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fabrial Cockpit",
        "width": 840,
        "height": 620,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:9191 ws://127.0.0.1:9191; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
